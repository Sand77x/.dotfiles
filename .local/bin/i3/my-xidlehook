#!/usr/bin/env bash

cache="$HOME/.cache/xidlehook_status"

[ -f "$cache" ] || echo "Saver:  ON" > "$cache"

# Run xidlehook
xidlehook \
  --socket '/var/tmp/xidlehook.sock' \
  --not-when-fullscreen \
  --not-when-audio \
  --timer 180 \
    'bright-set 0.4' \
    'bright-set' \
  --timer 150 \
    '! pgrep i3lock >/dev/null && i3lock-cool' \
    'bright-set' \
  --timer 480 \
    'systemctl suspend' \
    'bright-set' \
